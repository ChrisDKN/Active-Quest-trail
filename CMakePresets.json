{
  "version": 3,
  "configurePresets": [
    {
      "name": "linux",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/linux",
      "toolchainFile": "${sourceDir}/cmake/linux-clangcl.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "XWIN_SYSROOT": "${sourceDir}/.build-deps/xwin-v18"
      }
    },
    {
      "name": "windows",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/windows",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    }
  ],
  "buildPresets": [
    { "name": "linux", "configurePreset": "linux", "jobs": 2 },
    { "name": "windows", "configurePreset": "windows" }
  ]
}
